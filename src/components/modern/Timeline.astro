---
import config from '../../configs/modern-config.js';
import { formatDateRange } from '../../utils/experience';
---

{config.experience && config.experience.length > 0 && (
  <div class="mt-8">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Experience</h2>
    <ol class="relative border-s-2 border-gray-200 dark:border-gray-700 ms-3">
      {config.experience.map((item) => (
        <li class="mb-8 ms-6">
          <span class="absolute flex items-center justify-center w-3 h-3 bg-white dark:bg-gray-800 border-2 border-gray-400 dark:border-gray-500 rounded-full -start-[7px]" />
          <div class="flex flex-wrap items-baseline justify-between gap-x-3">
            <h3 class="font-semibold text-gray-900 dark:text-white">
              {item.icon && <i class={`fas fa-${item.icon} mr-2 text-gray-400 dark:text-gray-500`} aria-hidden="true" />}
              {item.role}
            </h3>
            {formatDateRange(item) && (
              <span class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">{formatDateRange(item)}</span>
            )}
          </div>
          <p class="text-gray-600 dark:text-gray-300">
            {item.url ? (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:underline"
                data-track-click
                data-track-title={item.organization}
                data-track-url={item.url}
                data-track-type="experience"
              >
                {item.organization}
              </a>
            ) : item.organization}
            {item.location && <span class="text-gray-400 dark:text-gray-500"> · {item.location}</span>}
          </p>
          {item.description && <p class="text-gray-500 dark:text-gray-400 text-sm mt-1">{item.description}</p>}
        </li>
      ))}
    </ol>
  </div>
)}
