---
import config from '../../configs/dev-config.js';
---

<div class="flex justify-center flex-wrap gap-2 mb-6">
  {config.socialLinks.map((link) => (
    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center w-10 h-10 rounded-md bg-slate-100 text-slate-600 hover:bg-slate-800 hover:text-white transition-colors duration-200"
      data-track-click
      data-track-title={link.platform}
      data-track-url={link.url}
      data-track-type="social"
    >
      <i class={`fab fa-${link.platform}`} aria-hidden="true"></i>
      <span class="sr-only">{link.platform}</span>
    </a>
  ))}
</div>
