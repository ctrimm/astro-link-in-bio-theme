---
interface Props {
  link: {
    title: string;
    url: string;
    icon?: string;
  };
  index?: number;
}

const { link, index = 0 } = Astro.props;
const accents = ['#FF3EA5', '#4CC9F0', '#7CFC6B'];
const accent = accents[index % accents.length];
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class="flex items-center w-full max-w-md mx-auto mb-4 bg-white border-4 border-black shadow-[6px_6px_0_0_#000] hover:shadow-[2px_2px_0_0_#000] hover:translate-x-[4px] hover:translate-y-[4px] transition-all duration-100 group"
  data-track-click
  data-track-title={link.title}
  data-track-url={link.url}
  data-track-type="link"
>
  <span class="w-3 self-stretch border-r-4 border-black" style={`background-color: ${accent};`}></span>
  <span class="flex items-center flex-1 px-4 py-4 gap-3">
    {link.icon && <i class={`fas fa-${link.icon} text-xl`} aria-hidden="true"></i>}
    <span class="flex-1 font-extrabold uppercase tracking-tight">{link.title}</span>
    <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform duration-150" aria-hidden="true"></i>
  </span>
</a>
