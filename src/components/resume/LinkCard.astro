---
interface Props {
  link: {
    title: string;
    url: string;
    icon?: string;
  };
}

const { link } = Astro.props;
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class="flex items-center justify-between w-full max-w-md mx-auto py-3 px-4 bg-white border border-slate-200 -mb-px first:rounded-t-lg last:rounded-b-lg hover:bg-slate-50 transition-colors duration-200"
  data-track-click
  data-track-title={link.title}
  data-track-url={link.url}
  data-track-type="link"
>
  <span class="flex items-center gap-3">
    {link.icon && <i class={`fas fa-${link.icon} text-indigo-600 w-4 text-center`} aria-hidden="true"></i>}
    <span class="font-medium text-slate-800">{link.title}</span>
  </span>
  <i class="fas fa-chevron-right text-slate-300 text-xs" aria-hidden="true"></i>
</a>
