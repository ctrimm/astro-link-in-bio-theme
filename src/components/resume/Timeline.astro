---
import config from '../../configs/resume-config.js';
import { formatDateRange } from '../../utils/experience';
---

{config.experience && config.experience.length > 0 && (
  <div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden mb-6">
    <div class="h-2 bg-indigo-600" />
    <div class="p-6">
      <h2 class="font-serif text-lg font-bold text-slate-900 mb-6">Experience</h2>
      <ol class="relative border-s-2 border-slate-200 ms-2">
        {config.experience.map((item) => (
          <li class="mb-7 ms-6 last:mb-0">
            <span class="absolute flex items-center justify-center w-3 h-3 bg-indigo-600 rounded-full ring-4 ring-white -start-[7px]" />
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <h3 class="font-semibold text-slate-900">
                {item.icon && <i class={`fas fa-${item.icon} mr-1.5 text-indigo-600`} aria-hidden="true" />}
                {item.role}
              </h3>
              {formatDateRange(item) && (
                <span class="text-xs font-medium uppercase tracking-wide text-slate-400 whitespace-nowrap">
                  {formatDateRange(item)}
                </span>
              )}
            </div>
            <p class="text-sm text-slate-600">
              {item.url ? (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-indigo-600 hover:underline"
                  data-track-click
                  data-track-title={item.organization}
                  data-track-url={item.url}
                  data-track-type="experience"
                >
                  {item.organization}
                </a>
              ) : item.organization}
              {item.location && <span class="text-slate-400"> · {item.location}</span>}
            </p>
            {item.description && <p class="text-sm text-slate-500 mt-1 leading-relaxed">{item.description}</p>}
          </li>
        ))}
      </ol>
    </div>
  </div>
)}
