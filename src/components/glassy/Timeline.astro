---
import config from '../../configs/glassy-config.js';
import { formatDateRange } from '../../utils/experience';
---

{config.experience && config.experience.length > 0 && (
  <div class="mt-6 p-6 rounded-3xl bg-white/10 backdrop-blur-xl border border-white/20 shadow-xl">
    <h2 class="text-xl font-bold text-white mb-6">Experience</h2>
    <ol class="relative border-s-2 border-white/30 ms-3">
      {config.experience.map((item) => (
        <li class="mb-6 ms-6 last:mb-0">
          <span class="absolute flex items-center justify-center w-3 h-3 bg-white/80 border-2 border-white/40 rounded-full -start-[7px]" />
          <div class="flex flex-wrap items-baseline justify-between gap-x-3">
            <h3 class="font-semibold text-white">
              {item.icon && <i class={`fas fa-${item.icon} mr-2 text-white/70`} aria-hidden="true" />}
              {item.role}
            </h3>
            {formatDateRange(item) && (
              <span class="text-xs text-white/60 whitespace-nowrap">{formatDateRange(item)}</span>
            )}
          </div>
          <p class="text-white/80 text-sm">
            {item.url ? (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:underline"
                data-track-click
                data-track-title={item.organization}
                data-track-url={item.url}
                data-track-type="experience"
              >
                {item.organization}
              </a>
            ) : item.organization}
            {item.location && <span class="text-white/50"> · {item.location}</span>}
          </p>
          {item.description && <p class="text-white/60 text-sm mt-1">{item.description}</p>}
        </li>
      ))}
    </ol>
  </div>
)}
