---
import '../styles/global.css';
import config from '../configs/glassy-config.js';
import PostHog from '../components/PostHog.astro';
import Navbar from '../components/Navbar.astro';

export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <PostHog />
  </head>
  <body class="min-h-screen relative flex flex-col text-white">
    <div
      class="absolute inset-0 bg-cover bg-center bg-no-repeat"
      style={`background-color: ${config.background.color}; background-image: url(${config.background.image});`}
    >
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/60 via-slate-900/40 to-slate-900/70"></div>
    </div>
    <Navbar />
    <main class="relative z-10 flex-1">
      <div class="container mx-auto px-4 py-8 max-w-md">
        <slot />
      </div>
    </main>
  </body>
</html>
